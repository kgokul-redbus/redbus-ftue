{
  "name": "india-bus-ds",
  "version": "1.0.0",
  "private": true,
  "description": "React binding for the Ions x Crystal India bus prototype kit",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/india-bus-ds.css"
  },
  "files": ["dist"],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:js": "tsc -p tsconfig.json",
    "build": "node scripts/build-icons.mjs && node scripts/build-css.mjs && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
